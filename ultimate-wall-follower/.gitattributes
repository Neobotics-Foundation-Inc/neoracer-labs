# Normalize line endings
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.bin binary

# Large robotics artifacts via Git LFS (run `git lfs install` once)
*.bag filter=lfs diff=lfs merge=lfs -text
*.db3 filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.engine filter=lfs diff=lfs merge=lfs -text
